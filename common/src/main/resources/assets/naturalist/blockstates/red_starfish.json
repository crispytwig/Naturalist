{
  "multipart": [
    {
      "when": {
        "north": true
      },
      "apply": {
        "model": "naturalist:block/red_starfish"
      }
    },
    {
      "when": {
        "east": true
      },
      "apply": {
        "model": "naturalist:block/red_starfish",
        "y": 90
      }
    },
    {
      "when": {
        "south": true
      },
      "apply": {
        "model": "naturalist:block/red_starfish",
        "y": 180
      }
    },
    {
      "when": {
        "west": true
      },
      "apply": {
        "model": "naturalist:block/red_starfish",
        "y": 270
      }
    },
    {
      "when": {
        "up": true
      },
      "apply": {
        "model": "naturalist:block/red_starfish",
        "x": 270,
        "uvlock": true
      }
    },
    {
      "when": {
        "down": true
      },
      "apply": {
        "model": "naturalist:block/red_starfish",
        "x": 90,
        "uvlock": true
      }
    }
  ]
}
