{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "issues": "https://github.com/crispytwig/Naturalist/issues"
  },
  "license": "${mod_license}",
  "icon": "naturalist.png",
  "environment": "*",
  "accessWidener": "naturalist.accesswidener",
  "entrypoints": {
    "main": [
      "com.crispytwig.naturalist.fabric.NaturalistFabric"
    ],
    "client": [
      "com.crispytwig.naturalist.fabric.client.NaturalistFabricClient"
    ],
    "lambdynlights:initializer": [
      "com.crispytwig.naturalist.client.compat.LambDynamicLightsCompat"
    ]
  },
  "mixins": [
    "naturalist.mixins.json",
    "naturalist.fieldguide.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "lambdynlights": "*"
  }
}
